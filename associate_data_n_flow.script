// Associate a Data Object with the Flow relations on its producer-to-consumer paths.
// Select one Data Object and run. Only adds associations; to also remove
// associations that are no longer on a path, use data_flow_consistency_fix.script.
// Requires the viewpoint data_flow_path_engine (data_flow_path_engine.script).

PATH_ENGINE = "data_flow_path_engine";

if (!selection.isList() || selection.empty()) {
    error "Select one Data Object in the view and run the script again.";
    stop;
}

selectedObject = selection[1];

if (selectedObject is "Reference") {
    selectedObject = selectedObject.to;
}

if (!selectedObject.isObject() || !selectedObject.isValid()) {
    error "The selection is not a valid model object.";
    stop;
}

if (!(selectedObject is "ArchiMate:ApplicationDataObject")) {
    error "Select a Data Object.";
    stop;
}

dataObject = selectedObject;

// ---- Flows on the paths, from the shared engine ----
flowsToAssociate = Set();
hints = List();
rows = query(PATH_ENGINE, dataObject);

if (!rows.isUndefined()) {
    forall row in rows {
        if (row[1] == "path") {
            flowsToAssociate.add(row[3]);
        } else if (row[1] == "hint") {
            hints.add(row);
        }
    }
}

header "Data object", "Flow", "Status";
created = 0;

forall flow in flowsToAssociate {
    label = flow.from.name() + " -> " + flow.to.name();
    associationExists = false;

    forall association in dataObject.relations("ArchiMate:AssociationRelation") {
        if (association.from == flow || association.to == flow) {
            associationExists = true;
        }
    }

    if (associationExists) {
        output dataObject, label, "already associated";
    } else if (flow.canAddRelationTo(dataObject, "ArchiMate:AssociationRelation")) {
        flow.addRelationTo(dataObject, "ArchiMate:AssociationRelation");
        output dataObject, label, "association created";
        created = created + 1;
    } else if (dataObject.canAddRelationTo(flow, "ArchiMate:AssociationRelation")) {
        dataObject.addRelationTo(flow, "ArchiMate:AssociationRelation");
        output dataObject, label, "association created";
        created = created + 1;
    } else {
        output dataObject, label, "could not associate";
    }
}

// Modelling hints from the engine (no changes are made for them).
forall hint in hints {
    if (hint[2] == "ignored route") {
        output dataObject, "Note: longer route from " + hint[4].name() + " to " +
            hint[3].name() + " via " + hint[5], "not associated (shortest kept); mark a processor if it should be used";
    } else if (hint[2] == "producer downstream") {
        output dataObject, "Warning: producer " + hint[3].name() + " is reached from producer " +
            hint[4].name(), "should it be read/write?";
    } else if (hint[2] == "behind consumer") {
        output dataObject, "Warning: consumer " + hint[3].name() + " is reachable only through consumer " +
            hint[4].name(), "should " + hint[4].name() + " be read/write?";
    }
}

if (flowsToAssociate.empty()) {
    output dataObject, "", "No producer-to-consumer path found";
}

output "Total", "", "Created " + created.toString() + " association(s).";
