// Probe: identify how Bizzdesign represents the selected view items.
// Draw a generic graphic line/connector (Create pane > graphic shapes) between two
// components on a view, select it together with a normal relation line and an
// element, run this script in the Query tool (output: Table) and send the result.

header "Item type", "Is reference", "Referred type", "Referred name";

forall selected in selection {
    if (selected is "Reference") {
        output selected.type().name(), "yes", selected.to.type().name(), selected.to.name();
    } else {
        output selected.type().name(), "no", "", selected.name();
    }
}
