flow = selection[1];

if (flow is "Reference") {
    flow = flow.to;
}

if (!(flow is "ArchiMate:FlowRelation")) {
    error "Select one Flow relation.";
    stop;
}

flowLabel = flow.from.name() + " -> " + flow.to.name();
dataObjects = Set();

forall association in flow.relations("ArchiMate:AssociationRelation") {
    relatedObject = association.from == flow ? association.to : association.from;

    if (relatedObject is "ArchiMate:ApplicationDataObject") {
        dataObjects.add(relatedObject);
    }
}

header "Flow", "Associated data object";

if (dataObjects.empty()) {
    output flowLabel, "No associated data object";
} else {
    forall dataObject in dataObjects {
        output flowLabel, dataObject.name();
    }
}