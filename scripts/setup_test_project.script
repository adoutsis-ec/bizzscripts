spec.add("AC|E17 Consume Processed|E17 Data|read");
spec.add("V|E18|E18 Parallel flows and repeated access");
spec.add("F|E18 Produce|-|-");
spec.add("F|E18 Consume|-|-");
spec.add("D|E18 Data");
spec.add("FL|E18 Produce|E18 Consume");
spec.add("FL|E18 Produce|E18 Consume");
spec.add("AC|E18 Produce|E18 Data|write");
spec.add("AC|E18 Consume|E18 Data|read");
spec.add("AC|E18 Consume|E18 Data|read/write");
spec.add("V|K01|K01 Consistency check and fix");
spec.add("F|K01 Produce|-|-");
spec.add("F|K01 Route|-|-");
spec.add("F|K01 Consume|-|-");
spec.add("F|K01 Side|-|-");
spec.add("D|K01 Data");
spec.add("FL|K01 Produce|K01 Route");
spec.add("FL|K01 Route|K01 Consume");
spec.add("FL|K01 Produce|K01 Side");
spec.add("AC|K01 Produce|K01 Data|write");
spec.add("AC|K01 Consume|K01 Data|read");
spec.add("AS|K01 Produce|K01 Route|K01 Data|flow");
spec.add("AS|K01 Produce|K01 Side|K01 Data|data");
spec.add("V|K02|K02 Role change workflow");
spec.add("C|K02 Source System|-");
spec.add("C|K02 Legacy System|-");
spec.add("C|K02 New System|-");
spec.add("F|K02 Produce|K02 Source System|-");
spec.add("F|K02 Old Consume|K02 Legacy System|-");
spec.add("F|K02 New Consume|K02 New System|-");
spec.add("D|K02 Data");
spec.add("FL|K02 Produce|K02 Old Consume");
spec.add("FL|K02 Old Consume|K02 New Consume");
spec.add("AC|K02 Produce|K02 Data|write");
spec.add("AC|K02 Old Consume|K02 Data|read");
spec.add("AS|K02 Produce|K02 Old Consume|K02 Data|flow");
spec.add("V|I01|I01 Impact analysis and routing");
spec.add("C|I01 Platform|-");
spec.add("C|I01 Hub System|I01 Platform");
spec.add("C|I01 Alt System|I01 Platform");
spec.add("C|I01 Source System|-");
spec.add("C|I01 Mid System|-");
spec.add("C|I01 Target System|-");
spec.add("F|I01 Produce|I01 Source System|-");
spec.add("F|I01 Transform|I01 Mid System|-");
spec.add("F|I01 Route Hub|I01 Hub System|-");
spec.add("F|I01 Route Alt|I01 Alt System|-");
spec.add("F|I01 Consume|I01 Target System|-");
spec.add("D|I01 Data");
spec.add("FL|I01 Produce|I01 Transform");
spec.add("FL|I01 Transform|I01 Route Hub");
spec.add("FL|I01 Transform|I01 Route Alt");
spec.add("FL|I01 Route Hub|I01 Consume");
spec.add("FL|I01 Route Alt|I01 Consume");
spec.add("AC|I01 Produce|I01 Data|write");
spec.add("AC|I01 Transform|I01 Data|read/write");
spec.add("AC|I01 Consume|I01 Data|read");
spec.add("V|R01|R01 Interface report");
spec.add("C|R01 Platform|-");
spec.add("C|R01 Sub A|R01 Platform");
spec.add("C|R01 Sub B|R01 Platform");
spec.add("C|R01 External System|-");
spec.add("C|R01 Isolated System|-");
spec.add("F|R01 Function A|R01 Sub A|-");
spec.add("F|R01 Function A.1|-|R01 Function A");
spec.add("F|R01 Function B|R01 Sub B|-");
spec.add("F|R01 External Function|R01 External System|-");
spec.add("F|R01 Unowned Function|-|-");
spec.add("D|R01 Data");
spec.add("FL|R01 External Function|R01 Function A");
spec.add("FL|R01 Function A.1|R01 Function B");
spec.add("FL|R01 Function B|R01 External Function");
spec.add("FL|R01 Function B|R01 Unowned Function");
spec.add("FL|R01 External System|R01 Platform");
spec.add("AS|R01 External Function|R01 Function A|R01 Data|flow");
spec.add("V|A01|A01 Create access relations");
spec.add("F|A01 Function 1|-|-");
spec.add("F|A01 Function 2|-|-");
spec.add("F|A01 Function 3|-|-");
spec.add("D|A01 Existing Data");
spec.add("AC|A01 Function 1|A01 Existing Data|read");

// ---- Guard: run only once ----
forall DATA_OBJECT existing in model {
    if (existing.name() == "E01 Data") {
        error "The test fixture already exists in this model (found 'E01 Data'). Use a new empty model.";
        stop;
    }
}

// ---- Seed view: where the scenario views are created ----
seedView = undefined;

if (selection.isList()) {
    forall selected in selection {
        candidate = selected;

        if (selected is "Reference") {
            candidate = selected.parent("AbstractView");
        }

        if (!candidate.isUndefined() && candidate.hasDiagram()) {
            seedView = candidate;
        }
    }
}

if (seedView.isUndefined()) {
    error "Select the Seed view in the model browser (or an element on it) and run the script again.";
    stop;
}

viewType = seedView.type();
viewContainer = seedView.parent();

if (viewContainer.isUndefined() || !viewContainer.canAddNewObject(viewType)) {
    error "Cannot create views next to the Seed view. Move the Seed view to a views folder and try again.";
    stop;
}

// ---- Where to create each element type ----
// The model root when it accepts the type; otherwise the folder of the element
// of that type placed on the Seed view.
elementTypes = List();
elementTypes.add(COMPONENT);
elementTypes.add(FUNCTION);
elementTypes.add(DATA_OBJECT);
containers = List();

forall elementType in elementTypes {
    container = undefined;

    if (model.canAddNewObject(elementType)) {
        container = model;
    }

    if (container.isUndefined()) {
        forall seedRef in seedView.allChildren() {
            if (container.isUndefined() && seedRef is "Reference") {
                seedObject = seedRef.to;

                if (!seedObject.isUndefined() && seedObject is elementType) {
                    folder = seedObject.parent();

                    if (!folder.isUndefined() && folder.canAddNewObject(elementType)) {
                        container = folder;
                    }
                }
            }
        }
    }

    if (container.isUndefined()) {
        error "Cannot find where to create elements of type " + elementType +
            ". Place one Application Component, one Application Function and one Data Object on the Seed view and run the script again.";
        stop;
    }

    containers.add(container);
}

// ---- Access type enumeration values, by display name ----
enumNames = List();
enumValues = List();
enumIndex = 0;

while (enumIndex < 4) {
    enumValue = Enum(enumIndex, "AccessRelationType");
    enumNames.add(enumValue.toString());
    enumValues.add(enumValue);
    enumIndex = enumIndex + 1;
}

// ---- Build the model content ----
header "Step", "Item", "Status";

byName = Index();
flowByKey = Index();
elements = List();
elementCodes = List();
relations = List();
relationCodes = List();
relationIsAssociation = List();
views = List();
viewCodes = List();
problems = 0;

forall line in spec {
    recordKind = field(line, 1);
    code = field(line, 2).substring(1, 3);
    pendingFrom = List();
    pendingTo = List();
    pendingType = List();
    created = undefined;

    if (recordKind == "V") {
        view = viewContainer.addNewObject(viewType, field(line, 3));
        views.add(view);
        viewCodes.add(field(line, 2));
        continue;
    }

    if (recordKind == "C" || recordKind == "F" || recordKind == "D") {
        name = field(line, 2);
        typeIndex = recordKind == "C" ? 1 : (recordKind == "F" ? 2 : 3);
        element = containers[typeIndex].addNewObject(elementTypes[typeIndex], name);
        byName.add(name, element);
        elements.add(element);
        elementCodes.add(code);

        if (recordKind != "D" && field(line, 3) != "-") {
            pendingFrom.add(byName.valueFor(field(line, 3)));
            pendingTo.add(element);
            pendingType.add(recordKind == "C" ? COMPOSITION : ASSIGNMENT);
        }

        if (recordKind == "F" && field(line, 4) != "-") {
            pendingFrom.add(byName.valueFor(field(line, 4)));
            pendingTo.add(element);
            pendingType.add(COMPOSITION);
        }
    } else if (recordKind == "FL") {
        pendingFrom.add(byName.valueFor(field(line, 2)));
        pendingTo.add(byName.valueFor(field(line, 3)));
        pendingType.add(FLOW);
    } else if (recordKind == "AC") {
        pendingFrom.add(byName.valueFor(field(line, 2)));
        pendingTo.add(byName.valueFor(field(line, 3)));
        pendingType.add(ACCESS);
    } else if (recordKind == "AS") {
        flow = flowByKey.valueFor(field(line, 2) + ">" + field(line, 3));
        dataObject = byName.valueFor(field(line, 4));

        if (field(line, 5) == "data") {
            pendingFrom.add(dataObject);
            pendingTo.add(flow);
        } else {
            pendingFrom.add(flow);
            pendingTo.add(dataObject);
        }

        pendingType.add(ASSOCIATION);
    }

    // Create the pending relations.
    position = 0;

    forall pending in pendingFrom {
        position = position + 1;
        source = pending;
        target = pendingTo[position];
        relationType = pendingType[position];

        // An association may be drawn in either direction.
        if (relationType == ASSOCIATION && !source.canAddRelationTo(target, relationType) &&
            target.canAddRelationTo(source, relationType)) {
            source = pendingTo[position];
            target = pending;
        }

        if (source.canAddRelationTo(target, relationType)) {
            created = source.addRelationTo(target, relationType);
            relations.add(created);
            relationCodes.add(code);
            relationIsAssociation.add(relationType == ASSOCIATION);
        } else {
            output "Relation", line, "NOT CREATED (not allowed by the metamodel)";
            problems = problems + 1;
        }
    }

    if (created.isUndefined()) {
        continue;
    }

    if (recordKind == "FL") {
        flowByKey.add(field(line, 2) + ">" + field(line, 3), created);
    } else if (recordKind == "AC") {
        accessType = field(line, 4);
        created.setAttrValue("accessType", enumValues[positionOf(enumNames, accessType)]);

        if (created.attrValue("accessType").toString() != accessType) {
            output "Access type", line, "COULD NOT BE SET";
            problems = problems + 1;
        }
    }
}

// ---- Fill the scenario views ----
viewPosition = 0;

forall view in views {
    viewPosition = viewPosition + 1;
    code = viewCodes[viewPosition];
    refs = Index();
    position = 0;

    forall element in elements {
        position = position + 1;

        if (elementCodes[position] == code && view.canAddNewReference(element)) {
            refs.add(element, view.addNewReference(element));
        }
    }

    // Pass 1: relations between elements. Pass 2: associations (they need the flow lines).
    pass = 1;

    while (pass <= 2) {
        position = 0;

        forall rel in relations {
            position = position + 1;

            if (relationCodes[position] != code || relationIsAssociation[position] != (pass == 2)) {
                continue;
            }

            if (!refs.contains(rel.from) || !refs.contains(rel.to)) {
                continue;
            }

            // Placing both ends on a view may already have drawn the relation.
            relRef = refOnView(rel, view);

            if (relRef.isUndefined() &&
                view.canAddNewReference(rel, refs.valueFor(rel.from), refs.valueFor(rel.to))) {
                relRef = view.addNewReference(rel, refs.valueFor(rel.from), refs.valueFor(rel.to));
            }

            if (relRef.isUndefined()) {
                output "View", view.name(), "could not draw " + rel.from.name() + " - " +
                    rel.to.name();
                problems = problems + 1;
            } else {
                refs.add(rel, relRef);
            }
        }

        pass = pass + 1;
    }

    if (view.canAutoLayoutDiagram()) {
        view.autoLayoutDiagram();
    }

    output "View", view.name(), refs.size().toString() + " item(s) placed";
}

output "Done", elements.size().toString() + " elements, " + relations.size().toString() +
    " relations, " + views.size().toString() + " views", problems.toString() + " problem(s)";
