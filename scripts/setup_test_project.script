// Test project setup for the data flow scripts.
//
// Builds the test fixture described in test_plan.md in an EMPTY model, so the
// scripts can be tested without touching the real model.
//
// Preparation (once, in a new empty ArchiMate model):
//   1. Create one ArchiMate view and name it "Seed".
//   2. Select the Seed view in the model browser (or any element on it) and run
//      this script. Output presentation type: Table.
//   3. If asked, place one Application Component, one Application Function and
//      one Data Object on the Seed view; they are only used to find the folders.
//
// Result: one view per test scenario (E01 ... A01), placed next to the Seed view.
// Each scenario has its own elements, all prefixed with the scenario code.
// The script refuses to run twice in the same model.

COMPONENT = "ArchiMate:ApplicationComponent";
FUNCTION = "ArchiMate:ApplicationFunction";
DATA_OBJECT = "ArchiMate:ApplicationDataObject";
FLOW = "ArchiMate:FlowRelation";
ACCESS = "ArchiMate:AccessRelation";
ASSIGNMENT = "ArchiMate:AssignmentRelation";
COMPOSITION = "ArchiMate:CompositionRelation";
ASSOCIATION = "ArchiMate:AssociationRelation";

// Returns field <number> (1-based) of a "|"-separated record.
function field(text, number) {
    rest = text;
    counter = 1;

    while (counter < number) {
        cut = rest.find("|");

        if (cut == 0) {
            return "";
        }

        rest = rest.substring(cut + 1);
        counter = counter + 1;
    }

    cut = rest.find("|");
    return cut == 0 ? rest : rest.substring(1, cut - 1);
}

// 1-based position of item in list, 0 when absent.
function positionOf(list, item) {
    counter = 0;

    forall element in list {
        counter = counter + 1;

        if (element == item) {
            return counter;
        }
    }

    return 0;
}

function refOnView(object, view) {
    forall ref in object.references() {
        if (ref.parent("AbstractView") == view) {
            return ref;
        }
    }

    return undefined;
}

// ---- Fixture specification ----
// V|code|view name                     view for all elements prefixed with code
// C|component|parent component or -   (composition parent -> component)
// F|function|owner component or -|parent function or -
// D|data object
// FL|from|to                           flow relation
// AC|element|data object|access type   access relation (write, read, read/write, none)
// AS|flow from|flow to|data object|flow or data   association, preferred direction
spec = List();
spec.add("V|E01|E01 Simple chain with router");
spec.add("C|E01 Source System|-");
spec.add("C|E01 Middleware|-");
spec.add("C|E01 Target System|-");
