spec.add("V|E15|E15 Flow carrying two data objects");
spec.add("F|E15 Produce|-|-");
spec.add("F|E15 Consume|-|-");
spec.add("D|E15 Data 1");
spec.add("D|E15 Data 2");
spec.add("FL|E15 Produce|E15 Consume");
