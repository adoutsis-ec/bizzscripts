// Routing functions report.
// Lists, per Data Object, the functions that pass it along a producer-to-consumer
// path without having an access relation to it (pure routers). Use it to confirm
// that routing is intended, or to find a missing read/write access relation.
// Scope: the selected Data Objects, otherwise all Data Objects in the model.
// Requires the viewpoint data_flow_path_engine (data_flow_path_engine.script).
// Output presentation type: Table.

PATH_ENGINE = "data_flow_path_engine";
DATA_OBJECT = "ArchiMate:ApplicationDataObject";

function ownerName(functionObject) {
    names = "";

    forall rel in functionObject.relationsTo("ArchiMate:AssignmentRelation") {
        if (rel.from is "ArchiMate:ApplicationComponent") {
            names = names.empty() ? rel.from.name() : names + ", " + rel.from.name();
        }
    }

    return names.empty() ? "(none)" : names;
}

// ---- Scope ----
dataObjects = List();

if (selection.isList()) {
    forall selected in selection {
        if (selected is "Reference") {
            selected = selected.to;
        }

        if (selected is DATA_OBJECT && !dataObjects.contains(selected)) {
            dataObjects.add(selected);
        }
    }
}

if (dataObjects.empty()) {
    forall DATA_OBJECT candidate in model {
        dataObjects.add(candidate);
    }
}

header "Router function", "Component", "Data object", "Receives from", "Forwards to";
routerCount = 0;

forall dataObject in dataObjects {
    // ---- Roles and path flows from the shared engine ----
    roleHolders = Set();
    pathFlows = List();
    rows = query(PATH_ENGINE, dataObject);

    if (!rows.isUndefined()) {
        forall row in rows {
            if (row[1] == "role") {
                roleHolders.add(row[2]);
            } else if (row[1] == "path" && !pathFlows.contains(row[3])) {
                pathFlows.add(row[3]);
            }
        }
    }

    // Routers: functions inside a path that have no access relation to the Data Object.
    routers = List();

    forall flow in pathFlows {
        if (!roleHolders.contains(flow.to) && !routers.contains(flow.to)) {
            routers.add(flow.to);
        }
    }

    forall router in routers {
        sources = List();
        targets = List();

        forall flow in pathFlows {
            if (flow.to == router && !sources.contains(flow.from.name())) {
                sources.add(flow.from.name());
            }

            if (flow.from == router && !targets.contains(flow.to.name())) {
                targets.add(flow.to.name());
            }
        }

        fromText = "";
        toText = "";

        forall name in sources.sorted() {
            fromText = fromText.empty() ? name : fromText + ", " + name;
        }

        forall name in targets.sorted() {
            toText = toText.empty() ? name : toText + ", " + name;
        }

        output router, ownerName(router), dataObject, fromText, toText;
        routerCount = routerCount + 1;
    }
}

if (routerCount == 0) {
    output "No routing-only functions found", "", "", "", "";
}
