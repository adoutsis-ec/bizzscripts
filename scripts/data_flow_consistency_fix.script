// Data flow consistency fix.
// Companion of data_flow_consistency_check.script. For the selected Data Objects
// (or all Data Objects when none are selected) it compares the flows on the
// producer-to-consumer paths with the flows associated with the Data Object:
//   - missing associations can be added
//   - extra associations (flow not on any path) can be deleted
// Run it after changing roles with manage_data_roles.script.
// You are asked to confirm before anything is changed.
// Requires the viewpoint data_flow_path_engine (data_flow_path_engine.script).
// Output presentation type: Table.

PATH_ENGINE = "data_flow_path_engine";
DATA_OBJECT = "ArchiMate:ApplicationDataObject";

// ---- Scope ----
dataObjects = List();

if (selection.isList()) {
    forall selected in selection {
        if (selected is "Reference") {
            selected = selected.to;
        }

        if (selected is DATA_OBJECT && !dataObjects.contains(selected)) {
            dataObjects.add(selected);
        }
    }
}

if (dataObjects.empty()) {
    forall DATA_OBJECT candidate in model {
        dataObjects.add(candidate);
    }
}

// ---- Analyse: collect all changes before modifying the model ----
addFlows = List();
addDataObjects = List();
extraAssociations = List();
extraDataObjects = List();

forall dataObject in dataObjects {
    expected = Set();
    rows = query(PATH_ENGINE, dataObject);

    if (!rows.isUndefined()) {
        forall row in rows {
            if (row[1] == "path") {
                expected.add(row[3]);
            }
        }
    }

    associated = Set();

    forall association in dataObject.relations("ArchiMate:AssociationRelation") {
        other = association.from == dataObject ? association.to : association.from;

        if (other is "ArchiMate:FlowRelation") {
            associated.add(other);

            if (!expected.contains(other)) {
                extraAssociations.add(association);
                extraDataObjects.add(dataObject);
            }
        }
    }

    forall flow in expected {
        if (!associated.contains(flow)) {
            addFlows.add(flow);
            addDataObjects.add(dataObject);
        }
    }
}

if (addFlows.empty() && extraAssociations.empty()) {
    messageBox("All flow associations are consistent. Nothing to change.",
        "Data flow consistency fix", "ok", "information");
    stop;
}

// Both answers are collected before anything is changed.
doAdd = false;
doDelete = false;

if (!addFlows.empty()) {
    answer = messageBox("Add " + addFlows.size().toString() +
        " missing flow association(s)? Cancel stops without any change.",
        "Data flow consistency fix", "yesnocancel", "information");

    if (answer == "cancel") {
        stop;
    }

    doAdd = answer == "yes";
}

if (!extraAssociations.empty()) {
    answer = messageBox("Delete " + extraAssociations.size().toString() +
        " extra flow association(s) that are not on any producer-consumer path?" +
        " Cancel stops without any change.",
        "Data flow consistency fix", "yesnocancel", "warning");

    if (answer == "cancel") {
        stop;
    }

    doDelete = answer == "yes";
}

header "Data object", "Flow", "Action", "Status";

// ---- Add missing associations ----
index = 0;

forall flow in addFlows {
    index = index + 1;
    dataObject = addDataObjects[index];
    label = flow.from.name() + " -> " + flow.to.name();

    if (!doAdd) {
        output dataObject, label, "Add association", "skipped (not confirmed)";
    } else if (flow.canAddRelationTo(dataObject, "ArchiMate:AssociationRelation")) {
        flow.addRelationTo(dataObject, "ArchiMate:AssociationRelation");
        output dataObject, label, "Add association", "added";
    } else if (dataObject.canAddRelationTo(flow, "ArchiMate:AssociationRelation")) {
        dataObject.addRelationTo(flow, "ArchiMate:AssociationRelation");
        output dataObject, label, "Add association", "added";
    } else {
        output dataObject, label, "Add association", "not allowed by metamodel";
    }
}

// ---- Delete extra associations ----
index = 0;

forall association in extraAssociations {
    index = index + 1;
    dataObject = extraDataObjects[index];
    flow = association.from == dataObject ? association.to : association.from;
    label = flow.from.name() + " -> " + flow.to.name();

    if (!doDelete) {
        output dataObject, label, "Delete association", "kept (not confirmed)";
    } else if (association.isValid()) {
        association.delete();
        output dataObject, label, "Delete association", "deleted";
    } else {
        output dataObject, label, "Delete association", "already removed";
    }
}