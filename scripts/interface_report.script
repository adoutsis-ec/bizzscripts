// Interface report for the selected Application Components.
// An interface is a Flow relation that crosses the component boundary:
// one end is inside the component, the other end is outside it.
// Inside = the component itself, its sub-components (composition, recursive),
// the Application Functions assigned to any of those, and their sub-functions.
// Output presentation type: Table.

COMPONENT = "ArchiMate:ApplicationComponent";
FUNCTION = "ArchiMate:ApplicationFunction";
DATA_OBJECT = "ArchiMate:ApplicationDataObject";

function addInternal(element, byref internal) {
    if (internal.contains(element)) {
        return;
    }

    internal.add(element);

    if (element is COMPONENT) {
        forall rel in element.relationsFrom("ArchiMate:AssignmentRelation") {
            if (rel.to is FUNCTION) {
                addInternal(rel.to, internal);
            }
        }
    }

    forall rel in element.relationsFrom("ArchiMate:CompositionRelation") {
        if (rel.to is COMPONENT || rel.to is FUNCTION) {
            addInternal(rel.to, internal);
        }
    }
}

function joinNames(objects) {
    names = List();

    forall object in objects {
        if (!names.contains(object.name())) {
            names.add(object.name());
        }
    }

    text = "";

    forall name in names.sorted() {
        text = text.empty() ? name : text + ", " + name;
    }

    return text;
}

function owningComponents(element) {
    if (element is COMPONENT) {
        single = List();
        single.add(element);
        return single;
    }

    owners = List();

    forall rel in element.relationsTo("ArchiMate:AssignmentRelation") {
        if (rel.from is COMPONENT) {
            owners.add(rel.from);
        }
    }

    forall rel in element.relationsTo("ArchiMate:CompositionRelation") {
        if (rel.from is FUNCTION) {
            owners = owners + owningComponents(rel.from);
        }
    }

    return owners;
}

function dataObjectsOf(flow) {
    objects = List();

    forall association in flow.relations("ArchiMate:AssociationRelation") {
        related = association.from == flow ? association.to : association.from;

        if (related is DATA_OBJECT) {
            objects.add(related);
        }
    }

    return objects;
}

function displayName(object) {
    return object.name().empty() ? "(unnamed)" : object.name();
}

// ---- Selected components ----
components = List();

forall selected in selection {
    if (selected is "Reference") {
        selected = selected.to;
    }

    if (selected is COMPONENT && !components.contains(selected)) {
        components.add(selected);
    }
}

if (components.empty()) {
    error "Select one or more Application Components and run the script again.";
    stop;
}

// ---- Report ----
header "Component", "Direction", "Internal element", "Flow", "External element",
    "External component", "Data objects";

forall component in components {
    internal = Set();
    addInternal(component, internal);

    outgoing = List();
    incoming = List();
    seen = Set();

    forall element in internal {
        forall flow in element.relations("ArchiMate:FlowRelation") {
            if (seen.contains(flow)) {
                continue;
            }

            seen.add(flow);

            if (internal.contains(flow.from) && !internal.contains(flow.to)) {
                outgoing.add(flow);
            } else if (internal.contains(flow.to) && !internal.contains(flow.from)) {
                incoming.add(flow);
            }
        }
    }

    if (outgoing.empty() && incoming.empty()) {
        output component, "-", "", "No interfaces found", "", "", "";
        continue;
    }

    forall flow in outgoing {
        external = flow.to;
        externalOwner = joinNames(owningComponents(external));
        output component, "Outgoing", flow.from, displayName(flow), external,
            externalOwner.empty() ? "(none)" : externalOwner,
            joinNames(dataObjectsOf(flow));
    }

    forall flow in incoming {
        external = flow.from;
        externalOwner = joinNames(owningComponents(external));
        output component, "Incoming", flow.to, displayName(flow), external,
            externalOwner.empty() ? "(none)" : externalOwner,
            joinNames(dataObjectsOf(flow));
    }
}
