// Data lineage for the selected Data Object(s).
// Shows how a Data Object travels from its producers to its consumers. Roles and
// paths come from the shared path engine; functions on a path without access to
// the Data Object are shown as routers.
// Requires the viewpoint data_flow_path_engine (data_flow_path_engine.script).
//
// MODE = "table"     -> presentation type Table (roles and paths).
// MODE = "highlight" -> presentation type "View: Highlight view"; highlights the
//                       Data Object, the functions and flows on its paths, and
//                       the access and association relations between them.

MODE = "table";

PATH_ENGINE = "data_flow_path_engine";
DATA_OBJECT = "ArchiMate:ApplicationDataObject";

function ownerName(functionObject) {
    names = "";

    forall rel in functionObject.relationsTo("ArchiMate:AssignmentRelation") {
        if (rel.from is "ArchiMate:ApplicationComponent") {
            names = names.empty() ? rel.from.name() : names + ", " + rel.from.name();
        }
    }

    return names.empty() ? "(none)" : names;
}

// ---- Selection ----
dataObjects = List();

if (selection.isList()) {
    forall selected in selection {
        if (selected is "Reference") {
            selected = selected.to;
        }

        if (selected is DATA_OBJECT && !dataObjects.contains(selected)) {
            dataObjects.add(selected);
        }
    }
}

if (dataObjects.empty()) {
    error "Select one or more Data Objects and run the script again.";
    stop;
}

if (MODE == "table") {
    header "Data object", "Kind", "Element", "Component(s)", "Role";
}

highlighted = Set();

forall dataObject in dataObjects {
    // ---- Roles and paths from the shared engine ----
    involved = List();
    roles = List();
    paths = List();
    currentPath = List();
    currentNumber = 0;
    rows = query(PATH_ENGINE, dataObject);

    if (!rows.isUndefined()) {
        forall row in rows {
            if (row[1] == "role") {
                involved.add(row[2]);
                roles.add(row[3]);
            } else if (row[1] == "path") {
                if (row[2] != currentNumber) {
                    if (!currentPath.empty()) {
                        paths.add(currentPath);
                    }

                    currentPath = List();
                    currentNumber = row[2];
                }

                currentPath.add(row[3]);
            }
        }
    }

    if (!currentPath.empty()) {
        paths.add(currentPath);
    }

    // Routers: functions on a path without a role.
    forall path in paths {
        forall flow in path {
            if (!involved.contains(flow.to)) {
                involved.add(flow.to);
                roles.add("router");
            }
        }
    }

    if (MODE == "table") {
        position = 0;

        forall functionObject in involved {
            position = position + 1;
            output dataObject, "Function", functionObject, ownerName(functionObject),
                roles[position];
        }

        if (paths.empty()) {
            output dataObject, "Path", "No producer-to-consumer path found", "", "";
        }

        pathNumber = 0;

        forall path in paths {
            pathNumber = pathNumber + 1;
            functionChain = path[1].from.name();
            componentChain = ownerName(path[1].from);

            forall flow in path {
                functionChain = functionChain + " -> " + flow.to.name();
                componentChain = componentChain + " -> " + ownerName(flow.to);
            }

            output dataObject, "Path " + pathNumber.toString(), functionChain,
                componentChain, path.size().toString() + " flow(s)";
        }
    } else {
        highlighted.add(dataObject);

        forall path in paths {
            forall flow in path {
                highlighted.add(flow);
                highlighted.add(flow.from);
                highlighted.add(flow.to);
            }
        }

        forall access in dataObject.relations("ArchiMate:AccessRelation") {
            other = access.from == dataObject ? access.to : access.from;

            if (highlighted.contains(other)) {
                highlighted.add(access);
            }
        }

        forall association in dataObject.relations("ArchiMate:AssociationRelation") {
            other = association.from == dataObject ? association.to : association.from;

            if (highlighted.contains(other)) {
                highlighted.add(association);
            }
        }
    }
}

if (MODE != "table") {
    forall object in highlighted {
        output object;
    }
}
