// Manage the data roles of a Data Object (access relations only).
//
// Use when the producer / processors / consumers of a Data Object change, for
// example when a new function is introduced and the old consumer becomes an
// intermediate processor.
//
// Selection: one Data Object, optionally together with Application Functions that
// should get a role (new functions). Elements may be selected on a view or in the
// model browser. Without a selected Data Object you are asked to pick one.
//
// Steps:
//   1. Current consumers and explicitly selected functions are reviewed, plus
//      (optionally) immediate flow neighbours of the current consumers.
//      Neighbour discovery is one hop only, in either direction. Other roles
//      remain unchanged; explicitly select an upstream function to edit it.
//      If a current consumer is explicitly selected, only selected functions
//      are reviewed, with no automatic consumers or neighbour question.
//   2. For each candidate you first say whether it should have access (No = router
//      or remove access), then pick the access type from the dropdown
//      (pre-filled with the current one), as in create_access_relations.script.
//   3. After confirmation the access relations are created / updated / deleted.
// Nothing is changed before all questions are answered; Cancel stops without changes.
//
// This script does not touch flow associations. Afterwards run
// data_flow_consistency_fix.script with the same Data Object selected to add / remove
// the flow associations for the new roles.
// Output presentation type: Table.

ACCESS_TYPE_ATTR = "accessType";
ACCESS_ENUM_TYPE = "AccessRelationType";
FUNCTION = "ArchiMate:ApplicationFunction";
COMPONENT = "ArchiMate:ApplicationComponent";
DATA_OBJECT = "ArchiMate:ApplicationDataObject";

// ---- Helper functions ----
function ownerName(functionObject) {
    names = "";

    forall rel in functionObject.relationsTo("ArchiMate:AssignmentRelation") {
        if (rel.from is COMPONENT) {
            names = names.empty() ? rel.from.name() : names + ", " + rel.from.name();
        }
    }

    return names.empty() ? "(none)" : names;
}

// 1-based position of item in list, 0 when absent.
function positionOf(list, item) {
    counter = 0;

    forall element in list {
        counter = counter + 1;

        if (element == item) {
            return counter;
        }
    }

    return 0;
}

function roleLabel(role) {
    if (role.empty()) {
        return "no access";
    }

    if (role == "write") {
        return "write (producer)";
    }

    if (role == "read/write") {
        return "read/write (processor)";
    }

    if (role == "read") {
        return "read (consumer)";
    }

    return role;
}

// ---- Access type enumeration values, by display name ----
enumNames = List();
enumValues = List();
enumIndex = 0;

while (enumIndex < 4) {
    enumValue = Enum(enumIndex, ACCESS_ENUM_TYPE);
    enumNames.add(enumValue.toString());
    enumValues.add(enumValue);
    enumIndex = enumIndex + 1;
}

forall required in List("read", "write", "read/write", "none") {
    if (!enumNames.contains(required)) {
        error "Access type '" + required + "' not found in enumeration " +
            ACCESS_ENUM_TYPE + ". Found: " + enumNames.toString();
        stop;
    }
}

// ---- Selection ----
dataObject = undefined;
candidates = List();

if (selection.isList()) {
    forall selected in selection {
        if (selected is "Reference") {
            selected = selected.to;
        }

        if (selected is DATA_OBJECT) {
            if (!dataObject.isUndefined() && dataObject != selected) {
                error "Select only one Data Object.";
                stop;
            }

            dataObject = selected;
        } else if (selected is FUNCTION && !candidates.contains(selected)) {
            candidates.add(selected);
        }
    }
}

if (dataObject.isUndefined()) {
    dataObject = ask(DATA_OBJECT, "Select the Data Object whose roles you want to change");

    if (dataObject.isUndefined()) {
        stop;
    }
}

// ---- Current roles ----
currentFunctions = List();
currentRoles = List();
currentAccess = List();

forall access in dataObject.relations("ArchiMate:AccessRelation") {
    functionObject = access.from == dataObject ? access.to : access.from;

    if (!(functionObject is FUNCTION) || currentFunctions.contains(functionObject)) {
        continue;
    }

    currentFunctions.add(functionObject);
    currentRoles.add(access.attrValue(ACCESS_TYPE_ATTR).toString());
    currentAccess.add(access);
}

participants = List();
currentConsumers = List();
selectionOnly = false;
position = 0;

forall functionObject in currentFunctions {
    position = position + 1;

    if (currentRoles[position] == "read") {
        currentConsumers.add(functionObject);

        if (candidates.contains(functionObject)) {
            selectionOnly = true;
        }
    }
}

if (!selectionOnly) {
    forall functionObject in currentConsumers {
        participants.add(functionObject);
    }
}

forall functionObject in candidates {
    if (!participants.contains(functionObject)) {
        participants.add(functionObject);
    }
}

// Only expand from the original consumers, never from discovered neighbours.
neighbours = List();

if (!selectionOnly) {
    forall functionObject in currentConsumers {
        forall flow in functionObject.relations("ArchiMate:FlowRelation") {
            other = flow.from == functionObject ? flow.to : flow.from;

            if (other is FUNCTION && !participants.contains(other) && !neighbours.contains(other)) {
                neighbours.add(other);
            }
        }
    }
}

if (!neighbours.empty()) {
    neighbourNames = "";

    forall functionObject in neighbours {
        neighbourNames = neighbourNames.empty() ? functionObject.name() :
            neighbourNames + ", " + functionObject.name();
    }

    answer = messageBox("Also review the " + neighbours.size().toString() +
        " immediate flow neighbour(s) of a current consumer? (" + neighbourNames + ")",
        "Data roles: " + dataObject.name(), "yesnocancel", "information");

    if (answer == "cancel") {
        stop;
    }

    if (answer == "yes") {
        forall functionObject in neighbours {
            participants.add(functionObject);
        }
    }
}

if (participants.empty()) {
    error "No current consumer or selected Application Function for '" + dataObject.name() +
        "'. Select the functions together with the Data Object and run the script again.";
    stop;
}

// ---- Ask the new role per function ----
newRoles = List();
position = 0;

forall functionObject in participants {
    position = position + 1;
    index = positionOf(currentFunctions, functionObject);
    oldRole = index > 0 ? currentRoles[index] : "";
    counterText = position.toString() + "/" + participants.size().toString();
    functionText = functionObject.name() + " [" + ownerName(functionObject) + "]";

    answer = messageBox(
        functionText + " -> " + dataObject.name() + "\n\nCurrent: " + roleLabel(oldRole) +
            "\n\nShould this function access the Data Object?\n\n" +
            "Yes = choose the access type\nNo = no access (router / remove access)",
        "Data roles " + counterText + ": " + functionObject.name(),
        "yesnocancel",
        "information"
    );

    if (answer == "cancel") {
        stop;
    }

    if (answer == "no") {
        newRoles.add("");
        continue;
    }

    title = "Access type " + counterText + ": " + functionText + " -> " + dataObject.name();

    if (index > 0) {
        chosen = ask(ACCESS_ENUM_TYPE, title, currentAccess[index].attrValue(ACCESS_TYPE_ATTR));
    } else {
        chosen = ask(ACCESS_ENUM_TYPE, title);
    }

    if (chosen.isUndefined()) {
        stop;
    }

    newRoles.add(chosen.toString());
}

// ---- Summary and confirmation ----
roleChanges = 0;
producerCount = 0;
consumerCount = 0;
position = 0;

forall functionObject in participants {
    position = position + 1;
    index = positionOf(currentFunctions, functionObject);
    oldRole = index > 0 ? currentRoles[index] : "";

    if (oldRole != newRoles[position]) {
        roleChanges = roleChanges + 1;
    }
}

// Count producers / consumers after the change, including role holders not reviewed.
position = 0;

forall functionObject in participants {
    position = position + 1;

    if (newRoles[position] == "write") {
        producerCount = producerCount + 1;
    } else if (newRoles[position] == "read") {
        consumerCount = consumerCount + 1;
    }
}

position = 0;

forall functionObject in currentFunctions {
    position = position + 1;

    if (!participants.contains(functionObject)) {
        if (currentRoles[position] == "write") {
            producerCount = producerCount + 1;
        } else if (currentRoles[position] == "read") {
            consumerCount = consumerCount + 1;
        }
    }
}

if (roleChanges == 0) {
    messageBox("No role changes.", "Data roles: " + dataObject.name(), "ok", "information");
    stop;
}

warningText = "";

if (producerCount == 0 || consumerCount == 0) {
    warningText = " Warning: '" + dataObject.name() + "' will have " +
        producerCount.toString() + " producer(s) and " +
        consumerCount.toString() + " consumer(s) (rule: at least one of each).";
}

answer = messageBox("Apply " + roleChanges.toString() + " role change(s)?" + warningText,
    "Data roles: " + dataObject.name(), "okcancel",
    warningText.empty() ? "information" : "warning");

if (answer != "ok") {
    stop;
}

// ---- Apply access changes ----
header "Data object", "Function", "Component", "Before", "After", "Action";
position = 0;

forall functionObject in participants {
    position = position + 1;
    newRole = newRoles[position];
    index = positionOf(currentFunctions, functionObject);
    oldRole = index > 0 ? currentRoles[index] : "";
    access = index > 0 ? currentAccess[index] : undefined;
    owner = ownerName(functionObject);

    if (oldRole == newRole) {
        output dataObject, functionObject, owner, roleLabel(oldRole), roleLabel(newRole),
            "unchanged";
        continue;
    }

    if (newRole.empty()) {
        access.delete();
        output dataObject, functionObject, owner, roleLabel(oldRole), "no access",
            "access relation deleted";
        continue;
    }

    action = "access type changed";

    if (access.isUndefined()) {
        if (!functionObject.canAddRelationTo(dataObject, "ArchiMate:AccessRelation")) {
            output dataObject, functionObject, owner, roleLabel(oldRole), roleLabel(newRole),
                "not allowed by metamodel";
            continue;
        }

        access = functionObject.addRelationTo(dataObject, "ArchiMate:AccessRelation");
        action = "access relation created";
    }

    access.setAttrValue(ACCESS_TYPE_ATTR, enumValues[positionOf(enumNames, newRole)]);

    if (access.attrValue(ACCESS_TYPE_ATTR).toString() != newRole) {
        action = action + " - WARNING: access type could not be set";
    }

    output dataObject, functionObject, owner, roleLabel(oldRole), roleLabel(newRole), action;
}

output dataObject, "", "", "", "",
    "Next: run data_flow_consistency_fix.script with this Data Object selected";